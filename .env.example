# Set these in your hosting environment or copy this file to .env and fill in the values.
# OpenAI-compatible chat completions API base URL:
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Use a long, random secret in production (for example: openssl rand -hex 32).
SESSION_SECRET=
# Optional. Defaults to ./data
# DATA_DIR=
# Optional. Defaults to 127.0.0.1:3000
# HOST=127.0.0.1
# PORT=3000
